{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node20",
    "lib": ["ES2020"],
    "moduleResolution": "nodenext",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
